    "mitt": "^3.0.1",
    "modern-normalize": "^3.0.1",
    "nanoid": "^5.1.5",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-datepicker": "^8.4.0",
    "react-dom": "^18.3.1",
    "react-focus-on": "^3.10.0",
