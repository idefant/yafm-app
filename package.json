    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^0.11.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.0",
    "openapi-typescript": "^6.7.6",
    "prettier": "^3.2.5",
    "react-devtools": "^6.1.2",
    "sass-embedded": "^1.89.2",
