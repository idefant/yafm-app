{
  "name": "yafm-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint -c .eslintrc.json --ext .js,.jsx,.ts,.tsx src",
    "lint:fix": "npm run lint -- --fix",
    "lint:css": "npx stylelint \"**/*.(s)?css\"",
    "lint:css:fix": "npm run lint:css -- --fix",
    "format": "prettier --write \"**/*.+(js|jsx|ts|tsx|json)\"",
    "debug:react": "react-devtools",
    "debug:redux": "redux-devtools --open --hostname=localhost --port=8000",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "schema:exrates:update": "npx openapi-typescript -o ./src/types/exrates-api-schema.d.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
